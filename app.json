{
  "expo": {
    "name": "OpenPayd Bank",
    "slug": "openpayd-bank-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openpayd.bank"
    },
    "android": {
      "package": "com.openpayd.bank",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}